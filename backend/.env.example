# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave DB_ENGINE unset (or anything other than "mysql") to use
# SQLite for quick local development. Set DB_ENGINE=mysql once a MySQL 8.x
# server is available.
DB_ENGINE=
DB_NAME=virtual_diary
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS (mobile app / any separate frontend during development)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_ALL_ORIGINS=True

# AI assistant (optional). Leave blank to keep AI features disabled.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Email (console backend prints emails to the terminal in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@virtualdiary.app
